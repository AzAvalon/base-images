{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "* 0-5 1,15 * *"
  ],
  "vulnerabilityAlerts": {
    "description": "Security fixes are opened right away, ignoring the schedule",
    "schedule": [
      "at any time"
    ],
    "addLabels": [
      "security"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dockerfiles/rust-.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "RUST_VERSION=(?<currentValue>[^\\s\\\\]+)"
      ],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "rustup-init release downloaded in the dev stage",
      "managerFilePatterns": [
        "/^dockerfiles/rust-.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "RUSTUP_VERSION=(?<currentValue>[^\\s\\\\]+)"
      ],
      "depNameTemplate": "rust-lang/rustup",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dockerfiles/rust-.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "BINSTALL_VERSION=(?<currentValue>[^\\s\\\\]+)"
      ],
      "depNameTemplate": "cargo-bins/cargo-binstall",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver",
      "description": "cargo-binstall release downloaded in the dev stage"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dockerfiles/rust-.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9-]*)@(?<currentValue>[0-9][^\\s\\\\]*)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Python packages installed with uv pip in the dev stage",
      "managerFilePatterns": [
        "/^dockerfiles/python.*\\.Dockerfile$/"
      ],
      "matchStrings": [
        "(?<depName>[a-zA-Z0-9][a-zA-Z0-9._-]*)==(?<currentValue>[^\\s\\\\]+)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "pre-commit"
      ],
      "description": "pre-commit/prek hooks release too often: once a month only",
      "schedule": [
        "* 0-5 1 * *"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "dockerfile"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge Rust dependency updates managed via custom regex.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "crate",
        "github-releases"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "rust",
        "automerge"
      ],
      "groupName": "rust dependencies (minor/patch)",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "rustup-init and cargo-binstall are checked against sha256 sums in the Dockerfile that Renovate cannot update: no automerge, the sums are bumped by hand in the PR",
      "matchPackageNames": [
        "rust-lang/rustup",
        "cargo-bins/cargo-binstall"
      ],
      "groupName": "pinned installers",
      "automerge": false,
      "prBodyNotes": [
        "Update the matching `*_SHA256_*` build args in `dockerfiles/rust-debian.Dockerfile` before merging; the build fails until they match."
      ]
    }
  ]
}
